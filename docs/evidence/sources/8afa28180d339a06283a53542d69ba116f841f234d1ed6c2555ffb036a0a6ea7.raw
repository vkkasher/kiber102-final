<script>
$(document).ready(function(){
  $('.nspInfo').each(function(){
    var title = $(this);
    // Объединяем оба replace в цепочку
    title.html(
      title.text()
        .replace(/(^\w+)/g, '<span>$1</span>') // Сначала оборачиваем первое слово
        .replace(/,/g, '<br>') // Затем заменяем все запятые на <br>
    );
  });
});   
</script>

<script>
$(document).ready(function(){
  $('.item-pagegl time').each(function(){
    var title = $(this);
    title.html(
      title.text()
        // Заменяем каждое слово на <span>слово</span>
        .replace(/(\w+)/g, '<span>$1</span>')
        // Затем заменяем запятые на <br>
        .replace(/,/g, '<br>')
    );
  });
});
</script>

