    title.html(
      title.text()
        // Заменяем каждое слово на <span>слово</span>
        .replace(/(\w+)/g, '<span>$1</span>')
        // Затем заменяем запятые на <br>
        .replace(/,/g, '<br>')
    );
  });
});
</script>

<script>
jQuery(function($){
   $("#ffphone").mask("+7(999)999-99-99");
   $("#ffphone2").mask("+7(999)999-99-99");
   });
</script>

