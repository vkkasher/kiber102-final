# Copy to .env. Use long unique secrets before starting Compose.
DATABASE_URL=postgresql+psycopg://kiber102:replace-database-password@postgres:5432/kiber102
POSTGRES_PASSWORD=replace-database-password
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
TRUSTED_PROXY_SECRET=replace-with-secure-32-byte-hex-secret
ADMIN_ACCOUNTS_JSON=
WORKER_ADMIN_USERNAME=admin
WORKER_ADMIN_PASSWORD=
NOTIFICATION_ADMIN_USERNAME=admin
NOTIFICATION_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SOURCE_ALLOWED_HOSTS=www.bashopera.ru,bashopera.ru,rusdram.ru,www.culture.ru,culture.ru,bashgf.ru,api.timepad.ru,pro.culture.ru,rusdramteatr.ru,ufa.kassy.ru,sterlitamak.kassy.ru
API_INTERNAL_URL=http://api:8000
API_URL=http://api:8000
WEB_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
WEB_PUBLIC_URL=
LLM_API_KEY=
# Optional: local, with LLM_BASE_URL=http://127.0.0.1:18080/v1 and LLM_MODEL=kiber102-local.
# Windows launcher installs pinned Qwen3-4B with ./run.ps1 -Install. API charges 0; hardware cost unknown.
LLM_PROVIDER=remote
# Use `llama-server.exe --list-devices` before selecting e.g. Vulkan1. CPU default is slower.
LLM_LOCAL_DEVICE=none
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_DAILY_REQUEST_LIMIT=30
LLM_DIALOG_REQUEST_LIMIT=10
LLM_DAILY_MAX_COST=0.03
LLM_DAILY_TOKEN_LIMIT=100000
LLM_MAX_CALL_COST=0.003
LLM_MAX_INPUT_TOKENS=16000
# USD per million tokens, enforced as OpenRouter provider price ceilings.
LLM_INPUT_PRICE_PER_MILLION=0.1
LLM_OUTPUT_PRICE_PER_MILLION=0.5
LLM_PRICE_CURRENCY=USD
# CBR 14 November 2026; refresh before a later deployment.
LLM_RUB_PER_CURRENCY_UNIT=82.1516
LLM_DIALOG_MAX_RUB=3
PROCULTURE_API_KEY=
TIMEPAD_API_TOKEN=
# Set your permitted OSRM endpoint to enable driving estimates; unknown coords stay unknown.
OSRM_BASE_URL=
# Explicit delivery opt-in. Browser subscriptions require Telegram linking before delivery.
NOTIFICATIONS_ENABLED=false
WORKER_INTERVAL_SECONDS=3600
SOURCE_VERIFICATION_MAX_AGE_HOURS=48
# system by default; opt-in doh only if local VPN uses reserved fake DNS addresses.
SOURCE_DNS_MODE=system

# Facts-only local citation demo. Production reuse permission is not granted.
SOURCE_ENABLE_STERLITAMAK_DEMO=0
